# BlastRadius Environment Configuration
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# HydraDB API Key (REQUIRED)
# Get your API key at: https://app.hydradb.com
# This is used for graph database queries and blast radius calculations
HYDRA_DB_API_KEY=your_hydradb_api_key_here

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Backend API Server Port (default: 3001)
# Change this if port 3001 is already in use on your machine
# PORT=3001

# Node Environment (default: development)
# Set to 'production' when deploying to hosting platforms
# NODE_ENV=development

# ═══════════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════════

# 1. Copy this file to create your .env file:
#    cp .env.example .env
#    
#    Or on Windows:
#    copy .env.example .env

# 2. Get your HydraDB API key:
#    - Visit https://app.hydradb.com
#    - Sign up or log in
#    - Navigate to your dashboard
#    - Copy your API key

# 3. Replace 'your_hydradb_api_key_here' above with your actual key

# 4. Save this file and run:
#    npm run seed        # First time only - populates database
#    npm run dev:all     # Start both frontend and backend

# ═══════════════════════════════════════════════════════════════════════════
# DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════

# For Vercel deployment:
#   1. Push code to GitHub
#   2. Import project to Vercel
#   3. Add HYDRA_DB_API_KEY in project settings → Environment Variables
#   4. Deploy

# For Netlify deployment:
#   1. Push code to GitHub
#   2. Import project to Netlify
#   3. Add HYDRA_DB_API_KEY in site settings → Environment Variables
#   4. Deploy

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY NOTES
# ═══════════════════════════════════════════════════════════════════════════

# ⚠️  NEVER commit your actual .env file to version control
# ⚠️  The .env file should be in .gitignore (already configured)
# ⚠️  Do not share your API key publicly
# ✓  Use different API keys for development and production
# ✓  Rotate your keys periodically for security

# ═══════════════════════════════════════════════════════════════════════════
# TROUBLESHOOTING
# ═══════════════════════════════════════════════════════════════════════════

# "HYDRA_DB_API_KEY is not set" error:
#   - Verify .env file exists in project root
#   - Check that HYDRA_DB_API_KEY is spelled correctly
#   - Ensure there are no spaces around the = sign
#   - Restart your development server after changing .env

# "Database connection failed":
#   - Verify your API key is valid at https://app.hydradb.com
#   - Check your internet connection
#   - Try running: npm run seed

# For more help, see:
#   - README.md - Full documentation
#   - DEMO.md - Quick start guide
#   - https://hydradb.com/docs - HydraDB documentation
